      ],
      "id": "146635d7-5bb1-4ed3-9176-a6b2932cafd8",
      "name": "If Schema is Empty"
    },
    {
      "parameters": {
        "jsCode": "// Normalize inputs from WordPress or Webhook / Custom API\nconst item = $input.item.json;\n\n// Check if incoming data is from Webhook\nif (item.body && (item.body.content || item.body.text)) {\n  const b = item.body;\n  return {\n    source: b.callback_url ? 'custom_api' : 'webhook',\n    id: b.id || b.post_id || 'custom-post',\n    title: b.title || 'Untitled Article',\n    url: b.url || '',\n    content: b.content || b.text,\n    callback_url: b.callback_url || null,\n    api_key: b.api_key || null\n  };\n}\n\n// Fallback to WordPress structure\nreturn {\n  source: 'wordpress',\n  id: item.id,\n  title: (item.title && item.title.rendered) ? item.title.rendered : (item.title || ''),\n  url: item.link || '',\n  content: (item.content && item.content.rendered) ? item.content.rendered : (item.content || ''),\n  callback_url: null,\n  api_key: null\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        -200
      ],
      "id": "e8d9c0b1-a2f3-4e5d-6c7b-8a9b0c1d2e3f",
      "name": "Normalize Article Input"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Article Title: ' + $json.title + '\\nURL: ' + $json.url + '\\n\\nContent:\\n' + $json.content }}",
        "options": {
          "systemMessage": "You are a Senior Technical SEO Expert. Extract and generate a complete, valid JSON-LD schema (@graph format combining Article, FAQPage, BreadcrumbList, and HowTo if applicable) from the article content. Output ONLY valid JSON inside a ```json block."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        160,
        -200
      ],
      "id": "7be8fa5e-1a63-4c09-aecf-518604c83d00",
      "name": "SEO Schema Agent"
    },
    {
      "parameters": {
        "model": "openai/gpt-4o-mini",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        160,
        20
      ],
      "id": "63632e65-0fe7-460a-93cc-53e9d3f82294",
      "name": "OpenRouter"
    },
    {
      "parameters": {
        "jsCode": "// Parse and validate generated JSON-LD schema\nconst item = $input.item.json;\nconst rawOutput = item.output || item.text || item.response || \"\";\n\nlet schemaJson = {};\nlet jsonString = rawOutput;\nconst match = rawOutput.match(/```(?:json)?\\s*([\\s\\S]*?)\\s*```/);\nif (match) {\n  jsonString = match[1];\n}\n\ntry {\n  schemaJson = JSON.parse(jsonString.trim());\n} catch (e) {\n  schemaJson = {\n    error: \"JSON parsing failed\",\n    raw_output: rawOutput\n  };\n}\n\nreturn {\n  source: item.source,\n  id: item.id,\n  title: item.title,\n  url: item.url,\n  callback_url: item.callback_url,\n  api_key: item.api_key,\n  schema: schemaJson,\n  schema_script: `<script type=\\\"application/ld+json\\\">\\n${JSON.stringify(schemaJson, null, 2)}\\n</script>`\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        -200
      ],
      "id": "f7e8d9c0-b1a2-4f3e-5d6c-7b8a9b0c1d2e",
      "name": "Extract & Validate Schema"
    },
