      "id": "9297a1dd-e0db-4d2b-92f5-52215cdb91bb",
      "name": "Get Post from WordPress"
    },
    {
      "parameters": {
        "jsCode": "// این کد کلمه کلیدی رو توی متن پیدا می‌کنه و اولین نمونه اش رو به لینک داخلی تبدیل می‌کنه\nconst post = $input.item.json;\nlet content = post.content || '';\nconst keyword = $('Extract links from JSON').item.json.Keyword;\nconst targetLink =$('Extract links from JSON').item.json.organic_results[0];\n\nif (keyword && targetLink && content.includes(keyword)) {\n  // جایگزینی اولین کلمه کلیدی با تگ لینک HTML\n  const regex = new RegExp(keyword, 'i');\n  content = content.replace(regex, `<a href=\"${targetLink}\">${keyword}</a>`);\n}\n\nreturn {\n  json: {\n    id: post.id,\n    content: content\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
