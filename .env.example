# Docker image version for n8n core
N8N_VERSION=2.43.4
# Docker image version for sandbox services
N8N_SANDBOX_VERSION=1.3.4

# Port for n8n web service
N8N_PORT=5678

# Public webhook URL (change to your domain on server)
WEBHOOK_URL=https://n8n.yourdomain.com/
# Public web editor URL
N8N_EDITOR_BASE_URL=https://n8n.yourdomain.com/
# Timezone for schedule triggers
GENERIC_TIMEZONE=Asia/Tehran
TZ=Asia/Tehran
# Master encryption key for credentials backup
N8N_ENCRYPTION_KEY=

# Run Code nodes in external container
N8N_RUNNERS_MODE=external
# Broker internal listen address
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
# Auth token between n8n and runner (generate with: openssl rand -hex 24)
N8N_RUNNERS_AUTH_TOKEN=replace_with_random_token

# Optional Brave Search API key (leave empty to use SearXNG)
INSTANCE_AI_BRAVE_SEARCH_API_KEY=
# Internal SearXNG URL (do not change)
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080
# SearXNG secret key (generate with: openssl rand -hex 24)
SEARXNG_SECRET=replace_with_random_secret

# Enable AI sandbox execution
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
# Sandbox provider identifier
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
# Internal sandbox API URLs (do not change)
N8N_INSTANCE_AI_SANDBOX_API_URL=http://sandbox-api:8080
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080

# Sandbox API auth key (both must match)
SANDBOX_API_KEYS=replace_with_random_key
N8N_SANDBOX_SERVICE_API_KEY=replace_with_random_key

# Sandbox runner registration token (both must match)
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=replace_with_random_token
SANDBOX_RUNNER_REGISTRATION_TOKEN=replace_with_random_token

# Sandbox runner API key (both must match)
SANDBOX_API_RUNNER_API_KEY=replace_with_random_key
SANDBOX_RUNNER_API_KEYS=replace_with_random_key
