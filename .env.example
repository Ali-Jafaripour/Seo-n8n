# ==============================================================================
# n8n Self-Hosted Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust values or generate fresh tokens:
#   cp .env.example .env
# To generate strong random hex tokens on Linux:
#   openssl rand -hex 24
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERSION CONFIGURATION
# ------------------------------------------------------------------------------
# Docker image tag for n8n core and code runners
N8N_VERSION=2.43.4

# Docker image tag for sandbox service API, runner, and sandbox images
N8N_SANDBOX_VERSION=1.3.4


# ------------------------------------------------------------------------------
# 2. PRODUCTION DOMAIN & WEBHOOKS (CRITICAL FOR PUBLIC SERVER)
# ------------------------------------------------------------------------------
# Public URL where n8n webhooks can be reached (Required for external webhooks)
# WEBHOOK_URL=https://n8n.yourdomain.com/

# Public URL of the n8n web editor UI
# N8N_EDITOR_BASE_URL=https://n8n.yourdomain.com/

# Timezone for n8n Schedule Triggers and Cron workflows
# GENERIC_TIMEZONE=Asia/Tehran
# TZ=Asia/Tehran

# Master Encryption Key for credentials (Required if migrating or restoring backup)
# N8N_ENCRYPTION_KEY=


# ------------------------------------------------------------------------------
# 3. TASK RUNNERS (ISOLATED CODE EXECUTION FOR JAVASCRIPT & PYTHON)
# ------------------------------------------------------------------------------
N8N_RUNNERS_MODE=external
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
N8N_RUNNERS_AUTH_TOKEN=replace_with_random_token


# ------------------------------------------------------------------------------
# 4. AI ASSISTANT WEB SEARCH (SEARXNG / BRAVE SEARCH)
# ------------------------------------------------------------------------------
INSTANCE_AI_BRAVE_SEARCH_API_KEY=
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=replace_with_random_secret


# ------------------------------------------------------------------------------
# 5. AI SANDBOX SERVICE CONFIGURATION (DOCKER-IN-DOCKER ISOLATION)
# ------------------------------------------------------------------------------
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_INSTANCE_AI_SANDBOX_API_URL=http://sandbox-api:8080
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080


# ------------------------------------------------------------------------------
# 6. SANDBOX SERVICE SECRETS & MUTUAL AUTHENTICATION TOKENS
# ------------------------------------------------------------------------------
# Must match each other:
SANDBOX_API_KEYS=replace_with_random_key
N8N_SANDBOX_SERVICE_API_KEY=replace_with_random_key

# Must match each other:
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=replace_with_random_token
SANDBOX_RUNNER_REGISTRATION_TOKEN=replace_with_random_token

# Must match each other:
SANDBOX_API_RUNNER_API_KEY=replace_with_random_key
SANDBOX_RUNNER_API_KEYS=replace_with_random_key
